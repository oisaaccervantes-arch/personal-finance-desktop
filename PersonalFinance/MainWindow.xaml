<Window x:Class="PersonalFinance.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PersonalFinance.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="None" Title="Personal Finance" Width="1440" Height="920" MinWidth="1080" MinHeight="700" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource AppFont}" FontSize="13" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
 <ResourceDictionary>

  <Style TargetType="DatePickerTextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="dd/mm/aaaa" FontSize="10" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>



  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="MaxDropDownHeight" Value="260"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputEdge}" BorderThickness="1" CornerRadius="12"><TextBlock Text="⌄" Foreground="#BAC8D5" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,12,30,12" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="{Binding Tag,RelativeSource={RelativeSource TemplatedParent},FallbackValue=Bottom,TargetNullValue=Bottom}" PopupAnimation="Fade" AllowsTransparency="True"><Border Background="{DynamicResource PopupSurface}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource InputEdge}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource TableRow}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource TableAlternate}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="54"/><Setter Property="ColumnHeaderHeight" Value="46"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeader}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource Divider}"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TitleControl" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonFill}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InputEdge}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MonthControl" TargetType="Button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource InputEdge}" Background="{DynamicResource ButtonFill}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHover}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary>
 </Window.Resources>
 <Grid ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid RenderTransformOrigin=".5,.5" Margin="-65" Background="{DynamicResource Backdrop}" x:Name="GlassBackdrop" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True"><Grid.CacheMode><BitmapCache/></Grid.CacheMode><Grid.RenderTransform><TransformGroup><ScaleTransform ScaleX="1.05" ScaleY="1.05"/><TranslateTransform x:Name="AmbientDrift"/></TransformGroup></Grid.RenderTransform>

   <Viewbox Stretch="Fill"><Canvas Width="1440" Height="1000" ClipToBounds="True">
    <Path Data="M -250,900 C 60,160 420,1160 880,260 C 1150,-280 1300,100 1600,-200" StrokeThickness="190"><Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#004A415C"/><GradientStop Color="#CFB7AFC9" Offset=".35"/><GradientStop Color="#0A181620" Offset=".57"/><GradientStop Color="#909D8BB3" Offset=".8"/><GradientStop Color="#00191929" Offset="1"/></LinearGradientBrush></Path.Stroke><Path.Effect><BlurEffect Radius="20"/></Path.Effect></Path>
    <Path Data="M -180,920 C 160,220 440,1150 920,280 C 1190,-170 1370,100 1550,-80" StrokeThickness="2" Stroke="#70E5DDF4"><Path.Effect><BlurEffect Radius="3"/></Path.Effect></Path>
    <Ellipse Width="850" Height="700" Canvas.Left="780" Canvas.Top="500"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#443F305C"/><GradientStop Color="#003F305C" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   </Canvas></Viewbox>
  </Grid>
  <Border x:Name="SidebarShell" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="20" Margin="14,18,0,18"><DockPanel Margin="14,22,14,14">
   <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="◈  Personal Finance" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="LOCAL  /  PERSONAL  /  PRIVADO" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,9,0,0"/></StackPanel>
   <Border DockPanel.Dock="Bottom" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="20" Padding="18"><StackPanel><TextBlock Text="PATRIMONIO TOTAL" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" FontSize="10"/><TextBlock x:Name="SidebarBalance" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,12"/><TextBlock Text="●  Datos en este equipo · MXN" Foreground="{DynamicResource TextSecondary}" FontSize="11"/></StackPanel></Border>
   <StackPanel x:Name="Navigation"/>
  </DockPanel></Border>
  <DockPanel x:Name="Workspace" Grid.Column="1">
   <Border DockPanel.Dock="Bottom" Padding="30,9" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"><TextBlock x:Name="Status" Text="Todo listo. Tus datos se guardan automáticamente en este equipo." Foreground="{DynamicResource TextSecondary}" FontSize="11"/></Border>
   <views:SmoothScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False"><StackPanel Margin="30,72,30,72"><DockPanel Margin="0,0,0,26"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="‹" Style="{StaticResource MonthControl}" Command="{Binding ChangeMonth}" CommandParameter="-1"/><TextBlock Text="{Binding MonthLabel}" Width="150" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="›" Style="{StaticResource MonthControl}" Command="{Binding ChangeMonth}" CommandParameter="1"/></StackPanel><StackPanel><TextBlock x:Name="PageTitle" FontSize="31" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/></StackPanel></DockPanel><StackPanel x:Name="ContentPanel"/></StackPanel></views:SmoothScrollViewer>
  </DockPanel>
  <Button x:Name="QuickAddButton" Grid.Column="1" Content="＋  Registrar movimiento" Click="OpenQuickMovement" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,52" Padding="23,17" Background="{DynamicResource AccentFill}" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" ToolTip="Registrar un ingreso o un gasto"/>
  <Border Grid.ColumnSpan="2" Height="48" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragTitle" Panel.ZIndex="2"/>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Panel.ZIndex="3"><Button Content="−" Style="{StaticResource TitleControl}" Click="MinimizeWindow" ToolTip="Minimizar"/><Button Content="□" Style="{StaticResource TitleControl}" Click="MaximizeWindow" ToolTip="Maximizar o restaurar"/><Button Content="×" Style="{StaticResource TitleControl}" Click="CloseWindow" ToolTip="Cerrar"/></StackPanel>
  <Grid x:Name="QuickOverlay" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed" Background="{DynamicResource Overlay}" KeyboardNavigation.TabNavigation="Cycle" KeyDown="QuickOverlayKeyDown">
   <ContentControl x:Name="QuickHost" Width="440" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,15,28,35"/>
  </Grid>
 </Grid>
</Window>
