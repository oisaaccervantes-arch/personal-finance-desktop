<UserControl x:Class="PersonalFinance.Views.CardFace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Viewbox Stretch="Uniform" MaxHeight="240">
  <Grid Width="360" Height="225">
   <Grid.Clip><RectangleGeometry Rect="0,0,360,225" RadiusX="20" RadiusY="20"/></Grid.Clip>
   <Border Background="{Binding CardPaint}" CornerRadius="20"/>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#50FFFFFF"/><GradientStop Color="#00FFFFFF" Offset=".4"/><GradientStop Color="#12FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <TextBlock Text="{Binding CardIssuer}" Foreground="{Binding CardInk}" FontSize="23" FontWeight="SemiBold" Margin="24,18,24,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
   <Canvas Margin="24,65,0,0" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Rectangle Width="48" Height="36" RadiusX="7" RadiusY="7" Stroke="#D9DFDD"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EEECE3"/><GradientStop Color="#AAB1AE" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Path Data="M 14,1 Q 20,9 14,15 L 1,15 M 14,15 L 14,22 L 1,22 M 14,22 Q 20,29 14,35 M 47,12 L 35,12 Q 30,18 35,24 L 47,24 M 20,5 L 30,5 M 20,31 L 30,31" Stroke="#89938F" StrokeThickness=".8"/>
    <Path Canvas.Left="278" Data="M 3,13 Q 9,20 3,27 M 9,8 Q 20,20 9,32 M 16,3 Q 31,20 16,37" Stroke="{Binding CardInk}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Canvas>
   <StackPanel Margin="24,119,24,0" VerticalAlignment="Top"><TextBlock Text="{Binding CardBalanceLabel}" Foreground="{Binding CardInk}" FontSize="9" Opacity=".8"/><TextBlock Text="{Binding CardBalance}" Foreground="{Binding CardInk}" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
   <TextBlock Text="{Binding CardCustomText}" Foreground="{Binding CardInk}" FontSize="12" Margin="24,0,24,18" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
   <Border BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="20" IsHitTestVisible="False"/>
  </Grid>
 </Viewbox>
</UserControl>
