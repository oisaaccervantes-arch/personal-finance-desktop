<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0FFFFFF" Offset="0"/><GradientStop Color="#20FFFFFF" Offset=".32"/><GradientStop Color="#10FFFFFF" Offset=".7"/><GradientStop Color="#A5DED3F4" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#303E3D4B"/><GradientStop Color="#6513141C" Offset=".6"/><GradientStop Color="#402B2735" Offset="1"/></LinearGradientBrush>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource ButtonFill}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/><Setter Property="Padding" Value="19,12"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="ButtonRoot" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
    <Border x:Name="Glow" CornerRadius="23" BorderThickness="1" BorderBrush="#91AFFF" Opacity="0" IsHitTestVisible="False"><Border.Effect><DropShadowEffect Color="#5282FF" BlurRadius="7" ShadowDepth="0" Opacity=".16"/></Border.Effect></Border>
    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22">
     <Grid>
      <Border x:Name="Reflection" CornerRadius="21" IsHitTestVisible="False" Opacity=".42"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".8,1"><GradientStop Color="#80DDE9FF"/><GradientStop Color="#08FFFFFF" Offset=".48"/><GradientStop Color="#00FFFFFF" Offset=".7"/><GradientStop Color="#248FB3FF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Border x:Name="Inset" CornerRadius="20" Margin="2" BorderThickness="0,1,0,1" BorderBrush="#407DA4E9" IsHitTestVisible="False"/>
      <Border x:Name="AccentRail" Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#75A1FF" CornerRadius="2" Margin="2,0,0,0" IsHitTestVisible="False" Opacity="0"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Grid>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></EventTrigger>
    <Trigger Property="Tag" Value="NavIdle"><Setter TargetName="Reflection" Property="Opacity" Value="0"/><Setter TargetName="Inset" Property="Opacity" Value="0"/><Setter TargetName="Body" Property="BorderThickness" Value="0"/></Trigger>
    <Trigger Property="Tag" Value="NavActive"><Setter TargetName="AccentRail" Property="Opacity" Value="1"/><Setter TargetName="Glow" Property="Opacity" Value=".55"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Reflection" Property="Opacity" Value=".75"/><Setter TargetName="Glow" Property="Opacity" Value="1"/><Setter TargetName="Body" Property="BorderBrush" Value="#A6BEFF"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".7"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>

